<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="mpalloS5.Views.vPersona"
             Title="vPersona">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="10">

            <Label 
                Text="Semana 5: BASES DE DATOS LOCALES"
                FontSize="20"
                VerticalOptions="Center" 
                HorizontalOptions="Center" />

            <Entry x:Name="txtName"
                   Placeholder="Ingresa el Nombre"/>

            <Button x:Name="btnAgregar"
                    Text="Agregar Persona"
                    Clicked="btnAgregar_Clicked"/>

            <Label x:Name="lblStatusMessage"
                   TextColor="Red" />

            <Button x:Name="btnMostrar"
                    Text="Mostrar Personas"
                    Clicked="btnMostrar_Clicked"/>

            <CollectionView x:Name="ListaPersonas" 
                            VerticalOptions="FillAndExpand"
                            HeightRequest="300">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>

                            <Label Text="{Binding Id}"
                                   Grid.Column="0"
                                   VerticalOptions="Center"/>

                            <Label Text="{Binding Name}"
                                   Grid.Column="1"
                                   VerticalOptions="Center"/>

                            <Button Text="Eliminar"
                                    Grid.Column="2"
                                    BackgroundColor="Red"
                                    TextColor="White"
                                    FontSize="12"
                                    Padding="0"
                                    Clicked="btnEliminar_Clicked"
                                    CommandParameter="{Binding Id}"/>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>